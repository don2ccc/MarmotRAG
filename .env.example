# GEMINI_API_KEY: Required for Gemini AI generation (grounded response).
# Not needed for embeddings — those use local Ollama.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL / pgvector connection settings (database ai_hub must exist with pgvector extension)
PG_HOST="localhost"
PG_PORT="5432"
PG_USER="postgres"
PG_PASSWORD="your_password_here"
PG_DATABASE="ai_hub"

# Ollama base URL for local nomic-embed-text embeddings
OLLAMA_BASE_URL="http://localhost:11434"
