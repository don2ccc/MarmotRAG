# MarmotRAG — retrieval-only RAG service

# PostgreSQL / pgvector connection settings (database ai_hub must exist with pgvector extension)
PG_HOST="localhost"
PG_PORT="5432"
PG_USER="postgres"
PG_PASSWORD="your_password_here"
PG_DATABASE="ai_hub"

# Ollama base URL for local embedding model
OLLAMA_BASE_URL="http://localhost:11434"

# EMBED_API: wire protocol of the embedding server.
#   "ollama" (default) → POST {OLLAMA_BASE_URL}/api/embeddings  {model, prompt}
#   "openai"           → POST {base}/embeddings                 {model, input}
# Use "openai" for LM Studio, vLLM, OpenAI, or any OpenAI-compatible server.
EMBED_API="ollama"

# EMBED_BASE_URL (optional): overrides OLLAMA_BASE_URL. For OpenAI-compatible
# servers include the version prefix, e.g. "http://localhost:1234/v1".
# EMBED_BASE_URL=""

# EMBED_API_KEY (optional): bearer token, only used when EMBED_API="openai".
# EMBED_API_KEY=""

# Ollama embedding model name — must exist locally (e.g. `ollama pull qwen3-embedding:4b`,
# the name you gave a custom GGUF import via `ollama create`, or the model key
# reported by an OpenAI-compatible server's /models endpoint)
OLLAMA_EMBED_MODEL="qwen3-embedding:4b"

# PORT: HTTP port the server listens on (default: 3000)
PORT="3000"

# CORS_ORIGINS: Comma-separated list of allowed origins.
# Use "*" for development. In production, set to your app/agent host(s).
CORS_ORIGINS="*"

# Demo identity: the dashboard uses the X-User-Id header (see README).
# Production can swap in session/JWT auth without changing route logic.
