# MarmotRAG — retrieval-only RAG service

# PostgreSQL / pgvector connection settings (database ai_hub must exist with pgvector extension)
PG_HOST="localhost"
PG_PORT="5432"
PG_USER="postgres"
PG_PASSWORD="your_password_here"
PG_DATABASE="ai_hub"

# Ollama base URL for local embedding model
OLLAMA_BASE_URL="http://localhost:11434"

# EMBED_API: wire protocol of the embedding server.
#   "ollama" (default) → POST {OLLAMA_BASE_URL}/api/embeddings  {model, prompt}
#   "openai"           → POST {base}/embeddings                 {model, input}
# Use "openai" for LM Studio, vLLM, OpenAI, or any OpenAI-compatible server.
EMBED_API="ollama"

# EMBED_BASE_URL (optional): overrides OLLAMA_BASE_URL. For OpenAI-compatible
# servers include the version prefix, e.g. "http://localhost:1234/v1".
# EMBED_BASE_URL=""

# EMBED_API_KEY (optional): bearer token, only used when EMBED_API="openai".
# EMBED_API_KEY=""

# Ollama embedding model name — must exist locally (e.g. `ollama pull qwen3-embedding:4b`,
# the name you gave a custom GGUF import via `ollama create`, or the model key
# reported by an OpenAI-compatible server's /models endpoint)
OLLAMA_EMBED_MODEL="qwen3-embedding:4b"

# EMBED_STORE_DIM: how many dimensions are actually stored/indexed (default 2000).
# pgvector can only build an HNSW index on `vector` columns up to 2000 dims, so
# 2560-dim models are truncated to this. Changing it clears stored vectors and
# re-embeds every source from its stored content in the background.
# EMBED_STORE_DIM="2000"

# EMBED_TIMEOUT_MS: per-request embedding timeout (default 120000).
# A local 4B model can need tens of seconds for a long chunk; a 30s cap failed
# whole builds on slow machines.
# EMBED_TIMEOUT_MS="120000"

# EMBED_CONCURRENCY: parallel embedding requests (default 1).
# Keep 1 for LM Studio or a single Ollama model — they process one request at a
# time, so concurrency only queues work behind the timeout. Raise for cloud APIs.
# EMBED_CONCURRENCY="1"

# MAX_CHUNK_CHARS: hard cap on chunk characters (default 2000, range 200-8000).
# Lower to 1200-1500 when the embedding model runs on CPU.
# MAX_CHUNK_CHARS="2000"

# BUILD_STALE_MS: an in-flight build older than this is considered abandoned and
# can be taken over by a new re-index (default 900000 = 15 min).
# BUILD_STALE_MS="900000"

# ── Authentication (admin console) ──────────────────────────────────────
# The console has a real sign-in: one admin account, session cookie signed with
# a secret persisted in the database (sessions survive restarts).
# On first boot, if the admin has no password, ADMIN_PASSWORD is applied; when
# it is empty a random password is printed once in the server log.
# ADMIN_EMAIL="admin@local"
# ADMIN_PASSWORD="change-me-at-least-8-chars"

# VERSION_RETENTION: how many versions keep their chunks for as-of queries
# (default 5). Older versions keep their metadata only.
# VERSION_RETENTION="5"

# PORT: HTTP port the server listens on (default: 3000)
PORT="3000"

# CORS_ORIGINS: Comma-separated list of allowed origins.
# Use "*" for development. In production, set to your app/agent host(s).
CORS_ORIGINS="*"

# Demo identity: the dashboard uses the X-User-Id header (see README).
# Production can swap in session/JWT auth without changing route logic.
